# ---- Grafana (the partner integration; load-bearing at runtime) ----
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxx
# Optional hosted Grafana Cloud MCP endpoint (else the local mcp-grafana binary is used):
GRAFANA_MCP_URL=
# Grafana Cloud Prometheus remote_write (used by Alloy, see scripts/alloy-config.river):
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_TOKEN=

# ---- Google / Gemini (required Google Cloud AI) ----
# Simplest path: an AI Studio API key.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Or Vertex AI instead:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# ---- Model tiers (verify current aliases at ai.google.dev/gemini-api/docs/models) ----
KALMAN_WATCHER_MODEL=gemini-flash-latest
KALMAN_DIAGNOSTICIAN_MODEL=gemini-pro-latest
KALMAN_SCRIBE_MODEL=gemini-flash-latest
